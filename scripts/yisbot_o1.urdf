<?xml version="1.0" ?>
<!-- 
URDF机器人描述文件 - 定义机器人的物理结构、关节、传感器等组件
此文件描述了一个基于TurtleBot3的机器人平台，包含移动底盘、传感器、执行器等
-->
<robot name="turtlebot3_waffle" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- 
  注释掉的xacro宏定义部分 - 用于定义相机相关参数
  这些参数定义了RGB相机和深度相机的相对位置偏移
  <xacro:include filename="$(find turtlebot3_description)/urdf/common_properties.urdf"/>

  <xacro:property name="r200_cam_rgb_px" value="0.005"/>
  <xacro:property name="r200_cam_rgb_py" value="0.018"/>
  <xacro:property name="r200_cam_rgb_pz" value="0.013"/>
  <xacro:property name="r200_cam_depth_offset" value="0.01"/> -->

  <!-- 
  材质定义部分 - 定义机器人各部件在仿真环境中的颜色和外观
  这些材质将在visual标签中引用，用于在Gazebo等仿真器中显示机器人的外观
  -->
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>  <!-- 黑色材质 -->
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>  <!-- 深灰色材质 -->
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>  <!-- 浅黑色材质 -->
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>  <!-- 蓝色材质 -->
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>  <!-- 绿色材质 -->
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>  <!-- 灰色材质 -->
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>  <!-- 橙色材质 -->
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>  <!-- 棕色材质 -->
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>  <!-- 红色材质 -->
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>  <!-- 白色材质 -->
  </material>

  <!-- 
  机器人坐标系定义
  base_footprint: 机器人的地面参考点，通常位于地面高度
  -->
  <link name="base_footprint"/>

  <!-- 
  固定关节：连接地面参考点到机器人主体
  将base_footprint与base_link连接，Z轴偏移0.01米（1厘米）
  -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>  <!-- 父链接：地面参考点 -->
    <child link="base_link" />       <!-- 子链接：机器人主体 -->
    <origin xyz="0 0 0.010" rpy="0 0 0"/>  <!-- 位置：X=0, Y=0, Z=0.01米，无旋转 -->
  </joint>

  <!-- 
  机器人主体链接 - 机器人的主要结构体
  包含视觉外观、碰撞检测和惯性属性定义
  -->
  <link name="base_link">
    <!-- 视觉外观定义 - 用于在仿真器中显示机器人的外观 -->
    <visual>
      <origin xyz="0.30 0.0 0.4" rpy="0 0 0"/>  <!-- 视觉几何体位置偏移 -->
      <geometry>
        <box size="0.86 0.68 0.8"/>  <!-- 长方体：长0.86m，宽0.68m，高0.8m -->
      </geometry>
      <material name="light_black"/>  <!-- 使用浅黑色材质 -->
    </visual>

    <!-- 碰撞检测几何体 - 用于物理仿真中的碰撞检测 -->
    <collision>
      <origin xyz="-0.2 -0.32 0.047" rpy="0 0 0"/>  <!-- 碰撞几何体位置偏移 -->
      <geometry>
        <box size="0.8 0.64 0.8"/>  <!-- 碰撞检测长方体：长0.8m，宽0.64m，高0.8m -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 定义机器人的质量和转动惯量，用于物理仿真 -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- 质心位置（相对于链接坐标系） -->
      <mass value="1.3729096e+00"/>  <!-- 质量：约1.37千克 -->
      <!-- 转动惯量矩阵 - 描述物体绕各轴旋转的惯性 -->
      <inertia ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04"
               iyy="8.6195418e-03" iyz="-3.5422299e-06"
               izz="1.4612727e-02" />
    </inertial>
  </link>

  <!-- 
  左轮关节 - 连续旋转关节，允许轮子无限旋转
  这是机器人的驱动轮之一，用于差分驱动
  -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>        <!-- 父链接：机器人主体 -->
    <child link="wheel_left_link"/>   <!-- 子链接：左轮 -->
    <origin xyz="0.0 0.268 0.023" rpy="-1.57 0 0"/>  <!-- 位置：Y=0.268m（左侧），Z=0.023m，绕X轴旋转-90度 -->
    <axis xyz="0 0 1"/>  <!-- 旋转轴：Z轴（垂直向上） -->
  </joint>

  <!-- 左轮链接 - 机器人的左驱动轮 -->
  <link name="wheel_left_link">
    <!-- 视觉外观 - 使用3D网格模型显示轮胎 -->
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>  <!-- 绕X轴旋转90度以正确定向 -->
      <geometry>
        <!-- 使用DAE格式的3D网格文件，缩放比例为0.001（毫米转米） -->
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/tire.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>  <!-- 深灰色材质 -->
    </visual>

    <!-- 碰撞检测 - 使用圆柱体简化几何体 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>  <!-- 圆柱体：长度1.8cm，半径3.3cm -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 轮子的质量和转动惯量 -->
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />  <!-- 质量：约28.5克 -->
      <!-- 转动惯量矩阵 -->
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <!-- 
  右轮关节 - 连续旋转关节，机器人的右驱动轮
  与左轮对称布置，实现差分驱动
  -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>         <!-- 父链接：机器人主体 -->
    <child link="wheel_right_link"/>   <!-- 子链接：右轮 -->
    <origin xyz="0.0 -0.268 0.023" rpy="-1.57 0 0"/>  <!-- 位置：Y=-0.268m（右侧），Z=0.023m，绕X轴旋转-90度 -->
    <axis xyz="0 0 1"/>  <!-- 旋转轴：Z轴（垂直向上） -->
  </joint>

  <!-- 右轮链接 - 机器人的右驱动轮 -->
  <link name="wheel_right_link">
    <!-- 视觉外观 - 使用3D网格模型显示轮胎 -->
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>  <!-- 绕X轴旋转90度以正确定向 -->
      <geometry>
        <!-- 使用DAE格式的3D网格文件，缩放比例为0.001（毫米转米） -->
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/tire.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>  <!-- 深灰色材质 -->
    </visual>

    <!-- 碰撞检测 - 使用圆柱体简化几何体 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>  <!-- 圆柱体：长度1.8cm，半径3.3cm -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 轮子的质量和转动惯量 -->
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />  <!-- 质量：约28.5克 -->
      <!-- 转动惯量矩阵 -->
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <!-- 
  万向轮（脚轮）系统 - 提供机器人稳定性和支撑
  万向轮允许机器人在任意方向移动，同时保持稳定
  -->
  
  <!-- 右后万向轮关节 - 固定关节，位于机器人后部右侧 -->
  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>              <!-- 父链接：机器人主体 -->
    <child link="caster_back_right_link"/>  <!-- 子链接：右后万向轮 -->
    <origin xyz="-0.1 -0.33 -0.004" rpy="-1.57 0 0"/>  <!-- 位置：X=-0.1m（后部），Y=-0.33m（右侧），Z=-0.004m（略低于地面） -->
  </joint>

  <!-- 右后万向轮链接 -->
  <link name="caster_back_right_link">
    <!-- 碰撞检测 - 使用小长方体表示万向轮 -->
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>  <!-- 轻微Y轴偏移 -->
      <geometry>
        <box size="0.030 0.009 0.020"/>  <!-- 长方体：长3cm，宽0.9cm，高2cm -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 万向轮质量很小 -->
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />  <!-- 质量：5克 -->
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <!-- 左后万向轮关节 - 固定关节，位于机器人后部左侧 -->
  <joint name="caster_back_left_joint" type="fixed">
    <parent link="base_link"/>             <!-- 父链接：机器人主体 -->
    <child link="caster_back_left_link"/>  <!-- 子链接：左后万向轮 -->
    <origin xyz="-0.1 0.17 -0.004" rpy="-1.57 0 0"/>  <!-- 位置：X=-0.1m（后部），Y=0.17m（左侧），Z=-0.004m（略低于地面） -->
  </joint>

  <!-- 左后万向轮链接 -->
  <link name="caster_back_left_link">
    <!-- 碰撞检测 - 使用小长方体表示万向轮 -->
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>  <!-- 轻微Y轴偏移 -->
      <geometry>
        <box size="0.030 0.009 0.020"/>  <!-- 长方体：长3cm，宽0.9cm，高2cm -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 万向轮质量很小 -->
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />  <!-- 质量：5克 -->
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>


  <!-- 
  超声波传感器系统 - 用于近距离障碍物检测
  超声波传感器通过发射和接收声波来测量距离
  -->
  
  <!-- 右侧超声波传感器关节 - 固定关节，位于机器人右侧 -->
  <joint name="superaudible_right_joint" type="fixed">
    <parent link="base_link"/>           <!-- 父链接：机器人主体 -->
    <child link="superaudible_right"/>   <!-- 子链接：右侧超声波传感器 -->
    <origin xyz="-0.1 -0.17 0.4" rpy="0.0 3.14159 0"/>  <!-- 位置：X=-0.1m（后部），Y=-0.17m（右侧），Z=0.4m（高度），绕Y轴旋转180度 -->
  </joint>

  <!-- 右侧超声波传感器链接 -->
  <link name="superaudible_right">
    <!-- 碰撞检测 - 使用小长方体表示传感器 -->
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>  <!-- 轻微Y轴偏移 -->
      <geometry>
        <box size="0.030 0.009 0.020"/>  <!-- 长方体：长3cm，宽0.9cm，高2cm -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 传感器质量很小 -->
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />  <!-- 质量：5克 -->
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <!-- 左侧超声波传感器关节 - 固定关节，位于机器人左侧 -->
  <joint name="superaudible_left_joint" type="fixed">
    <parent link="base_link"/>          <!-- 父链接：机器人主体 -->
    <child link="superaudible_left"/>   <!-- 子链接：左侧超声波传感器 -->
    <origin xyz="-0.1 0.33 0.4" rpy="0.0 3.14159 0"/>  <!-- 位置：X=-0.1m（后部），Y=0.33m（左侧），Z=0.4m（高度），绕Y轴旋转180度 -->
  </joint>

  <!-- 左侧超声波传感器链接 -->
  <link name="superaudible_left">
    <!-- 碰撞检测 - 使用小长方体表示传感器 -->
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>  <!-- 轻微Y轴偏移 -->
      <geometry>
        <box size="0.030 0.009 0.020"/>  <!-- 长方体：长3cm，宽0.9cm，高2cm -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 传感器质量很小 -->
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />  <!-- 质量：5克 -->
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>


  <!-- 
  IMU（惯性测量单元）传感器 - 用于测量机器人的姿态和加速度
  IMU提供陀螺仪、加速度计和磁力计数据，用于导航和定位
  -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>  <!-- 父链接：机器人主体 -->
    <child link="imu_link"/>    <!-- 子链接：IMU传感器 -->
    <origin xyz="0.15 0 0.068" rpy="0 0 0"/>  <!-- 位置：X=0.15m（前部），Y=0（中心），Z=0.068m（高度），无旋转 -->
  </joint>

  <!-- IMU传感器链接 - 仅定义坐标系，无几何体 -->
  <link name="imu_link"/>

  <!-- 
  GPS（全球定位系统）传感器 - 用于获取机器人的全球位置信息
  GPS提供经度、纬度和海拔高度数据，用于室外导航
  -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>  <!-- 父链接：机器人主体 -->
    <child link="gps_link"/>    <!-- 子链接：GPS传感器 -->
    <origin xyz="0.1 0.25 0" rpy="0 0 0"/>  <!-- 位置：X=0.1m（前部），Y=0.25m（右侧），Z=0（地面高度），无旋转 -->
  </joint>

  <!-- GPS传感器链接 - 仅定义坐标系，无几何体 -->
  <link name="gps_link"/>

  <!-- 
  地图坐标系 - 用于SLAM（同时定位与地图构建）和导航
  提供机器人在地图坐标系中的位置参考
  -->
  <joint name="base_link_map_joint" type="fixed">
    <parent link="base_link"/>      <!-- 父链接：机器人主体 -->
    <child link="base_link_map"/>   <!-- 子链接：地图坐标系 -->
    <origin xyz="0.69 -0.0 0.3" rpy="0 0 0"/>  <!-- 位置：X=0.69m（前部），Y=0（中心），Z=0.3m（高度），无旋转 -->
  </joint>

  <!-- 地图坐标系链接 - 仅定义坐标系，无几何体 -->
  <link name="base_link_map"/>

  <!-- 
  激光雷达传感器系统 - 用于环境感知和障碍物检测
  激光雷达通过发射激光束并测量反射时间来生成环境点云数据
  -->
  
  <!-- 右侧激光雷达关节 - 固定关节，位于机器人前部右侧 -->
  <joint name="laser_right_joint" type="fixed">
    <parent link="base_link"/>        <!-- 父链接：机器人主体 -->
    <child link="laser_frame_right"/> <!-- 子链接：右侧激光雷达 -->
    <origin xyz="0.69 -0.255 0.3" rpy="0 0 -0.03"/>  <!-- 位置：X=0.69m（前部），Y=-0.255m（右侧），Z=0.3m（高度），绕Z轴旋转-0.03弧度 -->
  </joint>

  <!-- 右侧激光雷达链接 - 仅定义坐标系，无几何体 -->
  <link name="laser_frame_right"/>

  <!-- 左侧激光雷达关节 - 固定关节，位于机器人前部左侧 -->
  <joint name="laser_left_joint" type="fixed">
    <parent link="base_link"/>       <!-- 父链接：机器人主体 -->
    <child link="laser_frame_left"/> <!-- 子链接：左侧激光雷达 -->
    <origin xyz="0.69 0.255 0.3" rpy="0 0 0.00"/>  <!-- 位置：X=0.69m（前部），Y=0.255m（左侧），Z=0.3m（高度），无旋转 -->
  </joint>

  <!-- 左侧激光雷达链接 - 仅定义坐标系，无几何体 -->
  <link name="laser_frame_left"/>

  <!-- 后部激光雷达关节1 - 固定关节，位于机器人后部 -->
  <joint name="laser_back_joint" type="fixed">
    <parent link="base_link"/>       <!-- 父链接：机器人主体 -->
    <child link="laser_frame_back"/> <!-- 子链接：后部激光雷达1 -->
    <origin xyz="0.24 0.0 0.0" rpy="0 3.14159 -1.5708"/>  <!-- 位置：X=0.24m（后部），Y=0（中心），Z=0（地面），绕Y轴旋转180度，绕Z轴旋转-90度 -->
  </joint>

  <!-- 后部激光雷达链接1 - 仅定义坐标系，无几何体 -->
  <link name="laser_frame_back"/>

  <!-- 后部激光雷达关节2 - 固定关节，位于机器人后部（不同朝向） -->
  <joint name="laser_back_joint1" type="fixed">
    <parent link="base_link"/>        <!-- 父链接：机器人主体 -->
    <child link="laser_frame_back1"/> <!-- 子链接：后部激光雷达2 -->
    <origin xyz="0.24 0.0 0.0" rpy="0 3.14159 1.5708"/>  <!-- 位置：X=0.24m（后部），Y=0（中心），Z=0（地面），绕Y轴旋转180度，绕Z轴旋转90度 -->
  </joint>

  <!-- 后部激光雷达链接2 - 仅定义坐标系，无几何体 -->
  <link name="laser_frame_back1"/>


  <!-- 
  导航坐标系 - 用于机器人导航和路径规划
  提供机器人导航算法的参考坐标系
  -->
  <joint name="base_nav_joint" type="fixed">
    <parent link="base_link"/>  <!-- 父链接：机器人主体 -->
    <child link="base_nav"/>    <!-- 子链接：导航坐标系 -->
    <origin xyz="0.0 -0.00 0.0" rpy="0 0 0.00"/>  <!-- 位置：与机器人主体重合，无偏移 -->
  </joint>

  <!-- 导航坐标系链接 - 仅定义坐标系，无几何体 -->
  <link name="base_nav"/>

  <!-- 
  激光雷达倾斜旋转机构 - 用于调整激光雷达的扫描角度
  这些机构允许激光雷达进行俯仰和旋转运动，扩大扫描范围
  -->
  
  <!-- 右侧倾斜旋转关节 - 固定关节，位于右侧激光雷达位置 -->
  <joint name="right_tilt_rotate_joint" type="fixed">
    <parent link="base_link"/>        <!-- 父链接：机器人主体 -->
    <child link="right_tilt_rotate"/> <!-- 子链接：右侧倾斜旋转机构 -->
    <origin xyz="0.69 -0.255 0.3" rpy="0 0 0"/>  <!-- 位置：X=0.69m（前部），Y=-0.255m（右侧），Z=0.3m（高度），无旋转 -->
  </joint>

  <!-- 右侧倾斜旋转机构链接 - 仅定义坐标系，无几何体 -->
  <link name="right_tilt_rotate"/>

  <!-- 左侧倾斜旋转关节 - 固定关节，位于左侧激光雷达位置 -->
  <joint name="left_tilt_rotate_joint" type="fixed">
    <parent link="base_link"/>       <!-- 父链接：机器人主体 -->
    <child link="left_tilt_rotate"/> <!-- 子链接：左侧倾斜旋转机构 -->
    <origin xyz="0.69 0.255 0.3" rpy="0 0 0"/>  <!-- 位置：X=0.69m（前部），Y=0.255m（左侧），Z=0.3m（高度），无旋转 -->
  </joint>

  <!-- 左侧倾斜旋转机构链接 - 仅定义坐标系，无几何体 -->
  <link name="left_tilt_rotate"/>



  <!-- 
  激光扫描仪（LDS - Laser Distance Sensor） - 主要的激光雷达传感器
  这是机器人的主要环境感知传感器，用于SLAM和导航
  -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>  <!-- 父链接：机器人主体 -->
    <child link="base_scan"/>   <!-- 子链接：激光扫描仪 -->
    <origin xyz="-0.064 0 0.122" rpy="0 0 0.0"/>  <!-- 位置：X=-0.064m（后部），Y=0（中心），Z=0.122m（高度），无旋转 -->
  </joint>

  <!-- 激光扫描仪链接 - 包含视觉、碰撞和惯性属性 -->
  <link name="base_scan">
    <!-- 视觉外观 - 使用3D网格模型显示激光扫描仪 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- 无位置和旋转偏移 -->
      <geometry>
        <!-- 使用DAE格式的3D网格文件，缩放比例为0.001（毫米转米） -->
        <mesh filename="package://turtlebot3_gazebo/models/turtlebot3_common/meshes/lds.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>  <!-- 深灰色材质 -->
    </visual>

    <!-- 碰撞检测 - 使用圆柱体简化几何体 -->
    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>  <!-- 轻微位置偏移 -->
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>  <!-- 圆柱体：长度3.15cm，半径5.5cm -->
      </geometry>
    </collision>

    <!-- 惯性属性 - 激光扫描仪的质量和转动惯量 -->
    <inertial>
      <mass value="0.114" />  <!-- 质量：114克 -->
      <origin xyz="0 0 0" />  <!-- 质心位置 -->
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <!-- 
  相机传感器 - 用于视觉感知和图像处理
  相机提供RGB图像数据，用于目标检测、识别和导航
  -->
  <joint name="camera_link_joint" type="fixed">
    <parent link="base_link"/>    <!-- 父链接：机器人主体 -->
    <child link="camera_link"/>   <!-- 子链接：相机传感器 -->
    <origin xyz="0.38 -0.265 0.68" rpy="0 0 0"/>  <!-- 位置：X=0.38m（前部），Y=-0.265m（右侧），Z=0.68m（高度），无旋转 -->
  </joint>

  <!-- 相机传感器链接 - 仅定义坐标系，无几何体 -->
  <link name="camera_link"/>
</robot>
