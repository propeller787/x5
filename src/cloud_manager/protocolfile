6.2 proto文件定义
该文件proto文件仅定义通过MQTT上报的车辆数据。
6.2.1 X5设备

syntax = "proto3";

package vehicle.up.x5;

// 公共基础字段（所有子模块共享 字段号1-19）
message BaseInfo {
 string vin = 1; // 车辆唯一标识
 int64 device_timestamp = 2; // 设备本地时间戳（毫秒）
 int32 model = 3; // 设备类型：0:X5、1:Cruise 固定0
string version = 4; //软件版本
}

// 1. 整车应用数据
message VehicleInfo {
 BaseInfo base = 1;
 float speed_kmh = 20; // 行驶速度（单位：km/h，float32 精度）
int32 remaining_mileage = 21; //剩余里程（单位：km，原float→int32兼容）
int32 gear = 22; // 档位（整数类型，如1=前进、2=后退、0=空挡）
int32 charging_status = 23; //充电状态（0=未充电、1=充电中、2=充满）
int32 parking_status = 24; //驻车状态（0=未驻车、1=已驻车）
int32 assist_mode = 25; //辅助模式（0=关闭、1=开启）
int32 battery = 26; //电池电量（单位：%，原float→int32，如50=50%）
int32 left_brakests = 27; // 左刹车状态 0 关闭 1 打开
int32 right_brakests = 28; // 右刹车状态 0 关闭 1 打开
float total_mileage = 29; // 总行驶里程（单位：m，累计不重置）
float current_interval_mileage = 30; // 当次行驶里程（单位：m，1分钟重置一次）
}
//2. 车辆状态数据 被动上传 字段内容修改才上传 
//各类型可空 空代表未变动
message VehicleStatus {
 BaseInfo base = 1;
 optional int32 recharge_status = 20; // 回充状态（0=未回充、1=回充中、2=回充完成）
 optional int32 summon_status = 21; // 召唤状态（0=未召唤、1=召唤中、2=召唤完成）
optional int32 follow_me_status = 22; // 跟我走状态（0=未跟随、1=跟随中）
optional string current_mode_chinese = 23; // 中文模式名称（空=避障关闭，非空=避障开启，如"巡航"）
optional int32 alarmstatus = 30; // 异常提醒
}

// 3. GPS 信息
message GPSData {
 BaseInfo base = 1;
 double timestamp = 20; //采样时间戳
 double latitude = 21; //纬度
 double longitude = 22; //经度
 double altitude = 23; //海拔
 float velocity_n = 24; //北向速度分量
 float velocity_e = 25; //东向速度分量
 float velocity_u = 26; //垂直速度分量
 uint32 fix_type = 27; //定位状态0=无效，1=单点，2=RTK浮动，3=RTK固定
 uint32 num_satellites = 28; //卫星数量
 float hdop = 29; //水平精度因子
}

// 4. 雷达信息
message RadarData {
 BaseInfo base = 1;

 double timestamp = 20; //采样时间
float angle_min = 21; //起始角度
 float angle_max = 22; //结束角度
 float angle_increment = 23; //每步角度增量
 float range_min = 24; //最小量程
 float range_max = 25; //最大量程

 repeated float ranges = 30; //距离数组（每个角度对应一条射线）
 repeated float intensities = 31; //反射强度（部分雷达可选）

 string frame_id = 40; //坐标系ID
}

// 5. 域控制器信息
message DomainControllerData {
 BaseInfo base = 1;

 float cpu_usage = 20; //CPU利用率
 float mem_usage = 21; //内存利用率
 uint32 network_status = 22; // 网络状态0离线 / 1连接中 / 2正常
 int32 error_code = 23; //错误码（0=正常）

 string robot_mode = 30; //当前模式（安全 巡航 回充等）
 string vehicle_id = 31; //车辆ID
}

// 6. 埋点事件
message EventLog {
 BaseInfo base = 1;

 string from = 20; //数据来源，固定值 "vlago"
 string type = 21; //消息类型，固定值 "trigger"
 string event = 22; //事件名称，如 "mode_switch_start"


 int64 timestamp = 23; // ms
 string timestamp_str = 24; //时间戳字符串 "YYYY-MM-DD HH:MM:SS"

 string node_name = 25; //ROS节点名称
 string file = 26; //源文件路径
 int32 line = 27; //源代码行号
 string function = 28; //函数名称

 map<string, string> data = 30; //业务数据键值对
}

// 7. 总数据容器
message VehicleMessage {
 BaseInfo base = 1;

 VehicleInfo info = 10;
 VehicleStatus status = 11;
 GPSData gps = 11;
 RadarData radar = 12;
 DomainControllerData domain_controller = 13;
 repeated EventLog event_logs = 14;
}


