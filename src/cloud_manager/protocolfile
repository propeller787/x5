签名编码UTF-8
示例如下：

// 引入 Ed25519（tweetnacl）
import nacl from 'tweetnacl';
import naclUtil from 'tweetnacl-util';

const PRIVATE_KEY = yourPrivateKeyUint8Array;

async function sendSignedHttpSimplified() {

 // 1. JSON Body
 const bodyObj = {
 speed: 12.5,
 battery: 88,
 status: "OK"
 };
 const bodyJson = JSON.stringify(bodyObj);

 // 2. gtime / gnonce
 const gtime = Date.now().toString();
 const gnonce = crypto.randomUUID();

 // 3. 拼接字符串（UTF-8）
 const signSource = token+gversion+glanguage+gclient+ GAppVersion+gtime+gnonce+bodyJson;

 // 4. 字符串 → UTF-8 字节
 const messageBytes = naclUtil.decodeUTF8(signSource);

 // 5. Ed25519 签名
 const signatureBytes = nacl.sign.detached(messageBytes, PRIVATE_KEY);
 const gsign = naclUtil.encodeBase64(signatureBytes);

 // 6. 发送 HTTP 请求
 const url = "https://你的域名/api/auth/v1/xxx";

 const response = await fetch(url, {
 method: "POST",
 headers: {
 "Content-Type": "application/json; charset=UTF-8",
 "Gtime": gtime,
 "Gnonce": gnonce,
 "Gsign": gsign
 },
 body: bodyJson
 });

 console.log("服务器响应:", await response.text());
}

