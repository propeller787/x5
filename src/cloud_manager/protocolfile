3.5.4 MQTT5
MQTT协议签名数据存放协议User Properties 示例如下：

// 引入 Paho MQTT 客户端
import { Client, Message } from 'paho-mqtt';

// 引入 Ed25519 实现（tweetnacl）
import nacl from 'tweetnacl';
import naclUtil from 'tweetnacl-util';

// 引入你的 Protobuf 文件（示例：DeviceState）
import { DeviceState } from './device_state_pb';

// =========================
// 1. 构造 Protobuf Payload
// =========================

// 创建一个 Protobuf 对象
const state = new DeviceState();

// 设置字段（示例字段，根据你的 proto 调整）
state.setSpeed(12.5);
state.setBattery(88);

// 序列化为 Uint8Array（二进制字节数组）
const payloadBytes = state.serializeBinary(); // 原始 Protobuf 字节

// =========================
// 2. 构造签名所需的字符串
// =========================

// gtime = 毫秒时间戳（字符串）
const gtime = Date.now().toString();

// gnonce = 随机字符串（防重放攻击）
const gnonce = Math.random().toString(36).substring(2, 10);

// =========================
// 3. 拼接 gtime + gnonce + payload
// =========================

// gtime 转为 UTF-8 字节
const gtimeBytes = naclUtil.decodeUTF8(gtime);

// gnonce 转为 UTF-8 字节
const gnonceBytes = naclUtil.decodeUTF8(gnonce);

// 计算拼接后的总长度
const totalLength =
 gtimeBytes.length +
 gnonceBytes.length +
 payloadBytes.length;

// 创建一个新的 Uint8Array 用于拼接
const messageToSign = new Uint8Array(totalLength);

// 写入偏移量
let offset = 0;

// 写入 gtime 字节
messageToSign.set(gtimeBytes, offset);
offset += gtimeBytes.length;

// 写入 gnonce 字节
messageToSign.set(gnonceBytes, offset);
offset += gnonceBytes.length;

// 写入 Protobuf 原始 payload
messageToSign.set(payloadBytes, offset);

// =========================
// 4. 使用 Ed25519 对消息进行签名
// =========================

// TODO: 替换成你的设备私钥（Uint8Array，长度 32 或 64）
const privateKey = yourPrivateKeyUint8Array;

// 使用 Ed25519 进行签名（返回 64 字节签名）
const signatureBytes = nacl.sign.detached(messageToSign, privateKey);

// 签名转 Base64，放入 MQTT User Properties
const gsign = naclUtil.encodeBase64(signatureBytes);

// =========================
// 5. 构造 MQTT5 消息并发送
// =========================

// 创建 MQTT 客户端（WebSocket 方式）
const client = new Client(
 "wss://your-emqx-server:8084/mqtt", // 替换为你的 EMQX WebSocket 地址
 "rn_" + Date.now() // 客户端 ID
);

// 连接到 EMQX（MQTT 5）
client.connect({
 useSSL: true, // 启用 TLS
 mqttVersion: 5, // 使用 MQTT 5.0
 onSuccess: () => {

 console.log("MQTT 连接成功");

 // 创建 MQTT 消息（payload 必须是原始二进制）
 const msg = new Message(payloadBytes);

 // 设置主题
 msg.destinationName = "device/state";

 // 设置 MQTT5 用户属性（用于传递签名）
 msg.userProperties = {
 gtime: gtime, // 时间戳
 gnonce: gnonce, // 随机数
 gsign: gsign // Base64 签名字符串
 };

 // 发送消息到 EMQX
 client.send(msg);

 console.log("消息已发送");
 }
});

接收服务端签名示例：

client.onMessageArrived = (message) => {

