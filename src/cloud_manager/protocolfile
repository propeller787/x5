3.4 签名算法
使用Ed25519 非对称算法进行数据签名已验证数据合法性防止接口被攻击，私钥由设备保存进行数据加签，公钥由服务端保存对数据进行验签。
各语言签名示例，必须是 UTF‑8 字节序列：
如签名内容为：signText = vin + "|" + model + "|" + nonce
1.	C++签名
使用 libsodium
#include <sodium.h>
#include <string>
std::string signMessage(
 const std::string& vin,
 const std::string& model,
 const std::string& nonce,
 const unsigned char* privateKey // 32 bytes
) {
 // build message
 std::string message = vin + "|" + model + "|" + nonce;
 unsigned char signature[crypto_sign_BYTES]; // 64 bytes
 crypto_sign_detached(
 signature,
 nullptr,
 reinterpret_cast<const unsigned char*>(message.c_str()),
 message.size(),
 privateKey
 );
 // return signature as base64
 char sigBase64[128];
 sodium_bin2base64(
 sigBase64, sizeof(sigBase64),
 signature, crypto_sign_BYTES,
 sodium_base64_VARIANT_ORIGINAL
 );
 return std::string(sigBase64);
}
//生成签名
std::string sig = signMessage(vin, model, nonce, devicePrivateKey);
1.	React Native签名
使用 tweetnacl
import nacl from 'tweetnacl';
import { encodeUTF8, decodeUTF8, encodeBase64 } from 'tweetnacl-util';
export function signDeviceMessage(vin, model, nonce, privateKeyBase64) {
 const privateKey = nacl.util.decodeBase64(privateKeyBase64); // Uint8Array(64)
 const message = `${vin}|${model}|${nonce}`;
 const msgUint8 = decodeUTF8(message);
 const signature = nacl.sign.detached(msgUint8, privateKey);
 return encodeBase64(signature); // base64 string
}
1.	服务端验签java
使用 BouncyCastle
import org.bouncycastle.crypto.params.Ed25519PublicKeyParameters;
import org.bouncycastle.crypto.signers.Ed25519Signer;
import java.util.Base64;
public class Ed25519Verify {
 public static boolean verify(
 String vin,
 String model,
 String nonce,
 String signatureBase64,
 byte[] publicKeyBytes // 32 bytes
 ) {
 String message = vin + "|" + model + "|" + nonce;
 byte[] msgBytes = message.getBytes(java.nio.charset.StandardCharsets.UTF_8);
 byte[] signature = Base64.getDecoder().decode(signatureBase64);
 Ed25519PublicKeyParameters pubKey = new Ed25519PublicKeyParameters(publicKeyBytes, 0);
 Ed25519Signer verifier = new Ed25519Signer();
 verifier.init(false, pubKey);
 verifier.update(msgBytes, 0, msgBytes.length);
 return verifier.verifySignature(signature);
 }
}
