 double direction = 8; //转向角度大于0向右 小于0向左
 int32 brake = 9; //是否踩刹车0未刹车 1刹车 刹车时速度为0
 int32 b_force = 10; //刹车力度0-100
 int64 d_ms = 11; //本次指令执行时长 毫秒
 int64 ttl_timeout = 5; //指令过期时长单位毫秒超时设备自动丢
}

9.2.4 设备运行时状态上报
syntax = "proto3";

package vehicle.ctr.status;

message VehicleCtrStatus {
 string ctr_id = 1; // 本轮控制的唯一编号
 string ctr_user_id = 2; //控制人的id
 int64 timestamp = 3; //设备毫秒时间戳

 int64 seq = 4; //命令序号 防止设备重复执行
 int32 cmd = 5; //0停止 1前进 -1后退
 double speed = 6; //速度(km/h)
 double speed_limit = 7; //限速(km/h)限制的最大速度
 double steering = 8; //转向角度大于0向右 小于0向左
 int32 brake = 9; //是否踩刹车0未刹车 1刹车 刹车时速度为0
 int32 b_force = 10; //刹车力度0-100
 double battery = 11; // 电量百分比
 //定位信息 =====
 double latitude = 12; // 纬度（WGS84）
 double longitude = 13; // 经度（WGS84）
 double altitude = 14; // 海拔（米）
 int32 error_code = 90; // 运行时错误码
 string error_message = 91; // 错误描述
}

