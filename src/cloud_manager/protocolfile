 BaseInfo base = 1;

 int32 gps_status = 20; //GPS状态 0=无效, 1=有效
 double longitude = 21; // 经度
 double latitude = 22; // 纬度
 float speed = 23; // 车速km/h
 float direction = 24; //航向角
 float mileage = 25; // km 总里程
 float power_level = 26; // 电量
 int32 engine_status = 27; // 动力系统状态0=熄火,1=启动
 int32 key_status = 28; // 车辆电源0=OFF,1=ACC,2=ON,3=Start
}

// 2. 报警与故障数据
message AlarmData {
 BaseInfo base = 1;

 string alarm_id = 20; // 报警代码
 string alarm_type = 21; // 报警类型说明
 int32 alarm_level = 22; // 1=紧急,2=严重,3=一般,4=提示

 string fault_code = 23; // DTC
 string fault_desc = 24; // 描述
 string additional_info = 25; // 扩展信息（直接字符串，不用JSON）
}

// 3. 驾驶行为与统计数据
message DrivingBehavior {
 BaseInfo base = 1;

 string trip_id = 20; //单次行程的唯一标识

 int64 start_time = 30; // 行程开始 UTC ms
 int64 end_time = 31; // 行程结束 UTC ms

 float trip_mileage = 40; // 行程里程km
 float avg_speed = 41; // 平均车速km/h
 float max_speed = 42; // 最高车速km/h

 int32 sharp_accel_count = 50; // 急加速次数
 int32 sharp_brake_count = 51; // 急刹车次数
 int32 sharp_turn_count = 52; // 急转弯次数
}

// 4. 传感器信息
message SensorInfo {
 BaseInfo base = 1;
 double timestamp = 20; //采样时间
 string sensor_type = 21;//传感器类型Camera、Radar、Lidar、Ultrasonic
 string sensor_id = 22; // 传感器唯一ID

 int32 sensor_status = 23;//传感器状态0正常,1故障,2校准中,3数据无效
 string sensor_data = 24; // 字符串描述感知结果

 float signal_strength = 30; //信号强度dB
 float fov = 31; //传感器的视场角度，例：120.0°
 int32 calibration_status = 32; //校准状态0=已校准,1=未,2=需校准
}

// 5. 域控制器系统状态
message DomainControllerStatus {
 BaseInfo base = 1;

 string domain_name = 20; // 控制器名称 ADAS / IVI / VCU
 string hw_part_number = 21; // 硬件版本号
 string sw_version = 22; // 软件版本

 int64 boot_time = 30; //本次启动时间ms
 int64 uptime = 31; //持续运行时间s

 float cpu_usage = 40; // CPU占用率%
 repeated float cpu_core_usage = 41; //各核CPU占用率

 int32 memory_total = 42; //总内存MB
 int32 memory_used = 43; //已用内存MB
 float memory_usage = 44; //内存使用率%

 int32 storage_total = 45; //总存储空间GB
 int32 storage_used = 46; //已用存储空间GB
 float storage_usage = 47; //存储使用率%

 float network_usage = 48; //网络使用率%

 string temperatures = 49; //温度信息JSON字符串
 repeated string process_list = 60; //在运行的关键进程名称
 string system_alert = 70; //统级别的告警信息
}

// 顶层消息封装（可用于 MQTT）
message CruiseMessage {
 BaseInfo base = 1;

 VehicleState vehicle_state = 10;
 AlarmData alarm_data = 11;
 SensorInfo sensor_info = 12;
 DomainControllerStatus domain_status = 13;
 DrivingBehavior driving_behavior = 14;
}

