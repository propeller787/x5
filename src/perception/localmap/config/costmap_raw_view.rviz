Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Alpha: 0.85
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Costmap Raw (viz)
      Topic: /local_costmap/costmap_raw/viz
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Costmap (occupancy)
      Topic: /local_costmap/costmap
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Occupymap Raw (viz)
      Topic: /localmap/occupymap_raw/viz
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Occupymap
      Topic: /localmap/occupymap
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Obstacle Points
      Size (m): 0.05
      Topic: /perception/obstacle_points
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Local Path
      Topic: /mppi/local_intent_path
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Distance: 12
      Name: Current View
      Target Frame: <Fixed Frame>
