<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wheelchair_obstacle</name>
  <version>0.0.1</version>
  <description>Wheelchair obstacle perception: point cloud preprocessing, clustering, costmap and control.</description>
  <maintainer email="m15137328778@163.com">likang</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>
  <depend>interface</depend>
  <depend>std_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>map_msgs</depend>
  <depend>pluginlib</depend>
  <depend>nav2_mppi_controller</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/gate_centerline_critic.xml" />
  </export>
</package>
