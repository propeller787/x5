Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Raw Laser Scans1
        - /Point Clouds1
        - /Point Clouds1/Fused Raw Cloud1
        - /Point Clouds1/Obstacle Filtered Cloud1
        - /Local Costmap1
